<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.DoNotBlink" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/black</item>
    </style>

    <!--
      The system window only. It is released on the first frame; the splash the player actually
      sees is Compose, and it is the window the ads/UMP work runs in.
    -->
    <style name="Theme.DoNotBlink.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.DoNotBlink</item>
    </style>
</resources>
